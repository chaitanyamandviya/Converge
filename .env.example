# ==============================================================================
# Converge Production Environment Variables (.env.example)
# ==============================================================================
# In production (e.g. Render, Railway, AWS, Docker), copy these variables
# into your platform's Environment Variables / Secrets dashboard.
# NEVER commit your real .env file with production credentials to GitHub!
# ==============================================================================

# Database Configuration (PostgreSQL / Neon)
DB_URL=jdbc:postgresql://<your-neon-host>.aws.neon.tech/converge
DB_USERNAME=neondb_owner
DB_PASSWORD=your_neon_db_password_here

# Server Port
PORT=8080

# JWT Authentication Secret (256-bit base64 key)
JWT_SECRET=your_secure_256bit_jwt_secret_here
JWT_EXPIRATION=7200000

# Meta Instagram Graph API
INSTAGRAM_GRAPH_API_BASE_URL=https://graph.facebook.com/v26.0
INSTAGRAM_ACCESS_TOKEN=your_meta_system_user_access_token_here
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id_here

# Resend Email Service
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=Converge <onboarding@resend.dev>
RESEND_ADMIN_EMAIL=chaitanyamandviya7@gmail.com

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://*.pages.dev,https://*.vercel.app
