# ==============================================================================
# Converge Backend Environment Variables (.env.example)
# ==============================================================================
# Set these in Render / Railway / container Environment Variables dashboard.
# NEVER commit your real .env file to GitHub!
# ==============================================================================

# PostgreSQL / Neon Database
DATABASE_URL=jdbc:postgresql://<your-neon-host>.aws.neon.tech/converge?sslmode=require
DATABASE_USERNAME=neondb_owner
DATABASE_PASSWORD=your_neon_db_password_here

# Server Port (Render injects $PORT)
PORT=8080

# JWT Signing Secret (64+ characters for HS512)
JWT_SECRET=replace_with_a_long_random_64_plus_byte_secret_key

# Google OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your_google_oauth_web_client_id.apps.googleusercontent.com

# System Admin
ADMIN_EMAIL=admin@converge.run.place
ADMIN_PASSWORD_HASH=

# Brevo Transactional Email API
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@converge.run.place
BREVO_SENDER_NAME=Converge

# Live Frontend URL (Cloudflare Pages)
FRONTEND_URL=https://converge-etp.pages.dev

# Meta / Instagram Graph API v26.0
INSTAGRAM_GRAPH_API_BASE_URL=https://graph.facebook.com/v26.0
INSTAGRAM_API_BASE_URL=https://graph.instagram.com/v26.0
INSTAGRAM_ACCESS_TOKEN=your_meta_system_user_access_token_here
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id_here
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://converge-etp.pages.dev/workspace
INSTAGRAM_CREATOR_MARKETPLACE_ENABLED=false
